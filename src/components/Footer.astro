---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-800 text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-lg font-semibold mb-4">Rasol Alkhair</h3>
        <p class="text-gray-300 text-sm">
          An umbrella of innovative products and professional services.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/rasol-alkhair/" class="text-gray-300 hover:text-white transition-colors">Home</a></li>
          <li><a href="/rasol-alkhair/portfolio" class="text-gray-300 hover:text-white transition-colors">Portfolio</a></li>
          <li><a href="/rasol-alkhair/blog" class="text-gray-300 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/rasol-alkhair/services" class="text-gray-300 hover:text-white transition-colors">Services</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-semibold mb-4">Connect</h3>
        <p class="text-gray-300 text-sm">
          Get in touch to learn more about our services.
        </p>
      </div>
    </div>
    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-sm text-gray-400">
      <p>&copy; {currentYear} Rasol Alkhair. All rights reserved.</p>
    </div>
  </div>
</footer>
