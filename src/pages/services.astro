---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Services - Rasol Alkhair"
  description="Book our consulting and development services"
>
  <Header />
  <main class="flex-grow">
    <section
      class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Services</h1>
        <p class="text-xl text-blue-100">
          Professional consulting and development solutions
        </p>
      </div>
    </section>

    <!-- Services Description -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <div class="bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-3xl font-bold mb-4 text-gray-900">Consulting</h2>
            <p class="text-gray-600 mb-6">
              Our consulting services provide expert guidance to help your
              business navigate challenges and seize opportunities. We bring
              strategic insights and proven methodologies to drive your success.
            </p>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Strategy development and planning
              </li>
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Process optimization
              </li>
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Technology assessment and recommendations
              </li>
            </ul>
          </div>
          <div class="bg-white p-8 rounded-lg shadow-md">
            <h2 class="text-3xl font-bold mb-4 text-gray-900">Development</h2>
            <p class="text-gray-600 mb-6">
              Our development team delivers custom software solutions tailored
              to your specific business requirements. We focus on quality,
              scalability, and maintainability.
            </p>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                Custom web and mobile applications
              </li>
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                API development and integration
              </li>
              <li class="flex items-start">
                <svg
                  class="w-6 h-6 text-blue-600 mr-2 flex-shrink-0"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                System architecture and design
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section class="py-16">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold mb-4 text-gray-900">
            Book a Consultation
          </h2>
          <p class="text-gray-600 text-lg">
            Fill out the form below and we'll get back to you within 24 hours.
          </p>
        </div>

        <div id="booking-form-container">
          <form id="booking-form" class="bg-white p-8 rounded-lg shadow-md">
            <div class="space-y-6">
              <!-- Name -->
              <div>
                <label
                  for="name"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="Your full name"
                />
              </div>

              <!-- Email -->
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Email <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="your.email@example.com"
                />
              </div>

              <!-- Phone -->
              <div>
                <label
                  for="phone"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Phone <span class="text-red-500">*</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="+1 (555) 000-0000"
                />
              </div>

              <!-- Service Type -->
              <div>
                <label
                  for="service"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Service Type <span class="text-red-500">*</span>
                </label>
                <select
                  id="service"
                  name="service"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                >
                  <option value="">Select a service</option>
                  <option value="Consulting">Consulting</option>
                  <option value="Development">Development</option>
                </select>
              </div>

              <!-- Preferred Date/Time -->
              <div>
                <label
                  for="datetime"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Preferred Date & Time <span class="text-red-500">*</span>
                </label>
                <input
                  type="datetime-local"
                  id="datetime"
                  name="datetime"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
              </div>

              <!-- Message -->
              <div>
                <label
                  for="message"
                  class="block text-sm font-medium text-gray-700 mb-2"
                >
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                  placeholder="Tell us about your project or consultation needs..."
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div>
                <button
                  type="submit"
                  class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                >
                  Submit Booking Request
                </button>
              </div>
            </div>
          </form>

          <!-- Success Message (hidden initially) -->
          <div
            id="success-message"
            class="hidden bg-green-50 border border-green-200 rounded-lg p-8 text-center"
          >
            <svg
              class="w-16 h-16 text-green-500 mx-auto mb-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Thank You!</h3>
            <p class="text-gray-600 mb-4">
              Your booking request has been submitted successfully. We'll get
              back to you within 24 hours.
            </p>
            <button
              id="submit-another"
              class="bg-blue-600 text-white py-2 px-6 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
            >
              Submit Another Request
            </button>
          </div>

          <!-- Error Message (hidden initially) -->
          <div
            id="error-message"
            class="hidden bg-red-50 border border-red-200 rounded-lg p-6 text-center"
          >
            <p class="text-red-600 font-medium">
              There was an error submitting your request. Please try again or
              contact us directly.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Google Apps Script Web App URL
  // REPLACE THIS with your deployed Web App URL from Step 3
  const GOOGLE_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbx-uc13X6BtK25gpf0gYmjDVr5IPnuB26T9I0CRevtvg36f1rY6f1bswzBZ0XBH2PU6/exec";

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("booking-form") as HTMLFormElement;
    const successMessage = document.getElementById("success-message");
    const errorMessage = document.getElementById("error-message");
    const submitAnotherBtn = document.getElementById("submit-another");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Get form data
      const formData = new FormData(form);
      const data = {
        name: formData.get("name") as string,
        email: formData.get("email") as string,
        phone: formData.get("phone") as string,
        service: formData.get("service") as string,
        datetime: formData.get("datetime") as string,
        message: formData.get("message") as string,
      };

      // Disable submit button
      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";
      }

      try {
        // Check if Google Script URL is configured
        if (GOOGLE_SCRIPT_URL === "YOUR_WEB_APP_URL_HERE") {
          throw new Error(
            "Please configure your Google Apps Script Web App URL",
          );
        }

        // Send to Google Sheets via Apps Script
        const response = await fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors", // Required for Google Apps Script
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        // Note: With no-cors mode, we can't read the response
        // We assume success if no error is thrown

        // Show success message
        form.classList.add("hidden");
        errorMessage?.classList.add("hidden");
        successMessage?.classList.remove("hidden");

        // Reset form
        form.reset();
      } catch (error) {
        console.error("Error submitting booking:", error);
        // Show error message
        const errorMsg = errorMessage?.querySelector("p");
        if (errorMsg) {
          errorMsg.textContent =
            error instanceof Error
              ? error.message
              : "There was an error submitting your request. Please try again.";
        }
        errorMessage?.classList.remove("hidden");
        setTimeout(() => {
          errorMessage?.classList.add("hidden");
        }, 5000);
      } finally {
        // Re-enable submit button
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Booking Request";
        }
      }
    });

    // Submit another request
    submitAnotherBtn?.addEventListener("click", () => {
      form.classList.remove("hidden");
      successMessage?.classList.add("hidden");
      errorMessage?.classList.add("hidden");
    });
  });
</script>
