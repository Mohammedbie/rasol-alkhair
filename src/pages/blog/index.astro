---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog - Rasol Alkhair" description="Read our latest insights and updates">
  <Header />
  <main class="flex-grow">
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Blog</h1>
        <p class="text-xl text-blue-100">Insights, updates, and perspectives</p>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        {sortedPosts.length === 0 ? (
          <div class="text-center py-12">
            <p class="text-gray-600 text-lg">No blog posts yet. Check back soon!</p>
          </div>
        ) : (
          <div class="space-y-8">
            {sortedPosts.map((post) => (
              <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
                <div class="p-8">
                  <time class="text-sm text-gray-500">
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <h2 class="text-3xl font-bold mt-2 mb-4 text-gray-900">
                    <a href={`/rasol-alkhair/blog/${post.slug}`} class="hover:text-blue-600 transition-colors">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="text-gray-600 mb-4 text-lg">{post.data.description}</p>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.map((tag) => (
                      <span class="px-3 py-1 bg-blue-100 text-blue-700 text-sm rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <a 
                    href={`/rasol-alkhair/blog/${post.slug}`}
                    class="text-blue-600 hover:text-blue-700 font-medium inline-flex items-center"
                  >
                    Read more →
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
